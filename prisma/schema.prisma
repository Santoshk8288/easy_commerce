generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  PENDING
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  UNKNOWN
}

enum BatchStatus {
  QUEUED
  PROCESSING
  COMPLETED
}

enum BatchItemStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model Order {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @unique @map("order_id")
  courierPartner    String          @map("courier_partner")
  courierShipmentId String?         @map("courier_shipment_id")
  awbNumber         String?         @map("awb_number")
  status            ShipmentStatus  @default(PENDING)
  requestPayload    Json            @map("request_payload")
  courierRequest    Json?           @map("courier_request")
  courierResponse   Json?           @map("courier_response")
  lastErrorCode     String?         @map("last_error_code")
  lastErrorMessage  String?         @map("last_error_message")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  trackingHistory   TrackingEvent[]
  batchItems        BulkBatchItem[]

  @@index([courierPartner])
  @@index([awbNumber])
  @@map("orders")
}

model TrackingEvent {
  id             BigInt         @id @default(autoincrement())
  orderId        String         @map("order_id") @db.Uuid
  status         ShipmentStatus
  occurredAt     DateTime       @map("occurred_at")
  rawPayload     Json           @map("raw_payload")
  createdAt      DateTime       @default(now()) @map("created_at")
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@map("tracking_events")
}

model BulkBatch {
  id          String          @id @default(uuid()) @db.Uuid
  status      BatchStatus     @default(QUEUED)
  totalCount  Int             @map("total_count")
  successCount Int            @default(0) @map("success_count")
  failureCount Int            @default(0) @map("failure_count")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  items       BulkBatchItem[]

  @@map("bulk_batches")
}

model BulkBatchItem {
  id             String          @id @default(uuid()) @db.Uuid
  batchId        String          @map("batch_id") @db.Uuid
  orderRecordId  String?         @map("order_record_id") @db.Uuid
  externalOrderId String         @map("external_order_id")
  courierPartner String          @map("courier_partner")
  status         BatchItemStatus @default(QUEUED)
  errorCode      String?         @map("error_code")
  errorMessage   String?         @map("error_message")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  batch          BulkBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order          Order?          @relation(fields: [orderRecordId], references: [id], onDelete: SetNull)

  @@unique([batchId, externalOrderId])
  @@index([batchId, status])
  @@map("bulk_batch_items")
}
